{
  "name": "ozan-b-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/prepare-media.mjs && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "optimize": "node scripts/prepare-media.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:images": "node --test scripts/optimize-images.test.mjs",
    "import:gallery": "node scripts/import-gallery.mjs",
    "test:gallery": "node --test scripts/gallery.test.mjs",
    "verify:gallery": "node scripts/verify-gallery.mjs",
    "test:admin": "tsx --test tests/cms.test.ts",
    "admin:password": "tsx scripts/admin-password.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.34.5",
    "@node-rs/argon2": "^2.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "typescript": "^5",
    "tsx": "^4.23.15"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  }
}
