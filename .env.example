# Local: use http://localhost:3000. Production must use the real HTTPS domain.
SITE_URL=http://localhost:3000
CMS_ORIGIN=http://localhost:3000
# VPS: use a persistent directory outside the Git checkout.
# CMS_DATA_DIR=/var/lib/16mm-production/cms
# Debian/Ubuntu: sudo apt install ffmpeg
# FFMPEG_PATH=/usr/bin/ffmpeg

# Cloud mode remains supported. Leave these unset for an independent VPS:
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=
